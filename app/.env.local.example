# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
#   cp .env.local.example .env.local
#
# Both values below are from:
#   Supabase dashboard -> Project Settings -> API
#
# These two are SAFE to expose: the URL is public, and the anon/publishable key
# is designed to be shipped to browsers. It grants nothing on its own — every
# query it makes is filtered by the row-level security policies in
# supabase/migrations/0006_rls.sql.
NEXT_PUBLIC_SUPABASE_URL=https://lwffqugbvbcmpgpsllft.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# DO NOT add the service_role key or the database password here.
#
# The service_role key bypasses row-level security completely — anything
# holding it can read and write every row belonging to every user. This app
# does not need it: all reads and writes go through the authenticated user's
# own session, which is the point of the RLS design.
#
# If you ever do need it for an admin script, keep it in a separate file that
# is never imported by client code, and never paste it into a chat or commit.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Optional — the 6pm digest (0018_daily_digest.sql). /digest works without any
# of these: it always renders the plain-text summary for one-tap copy-paste.
# They only add the automated Vercel Cron -> WhatsApp path on top.
# ---------------------------------------------------------------------------

# Locks Vercel Cron's own call to /api/digest. Any random string; Vercel sends
# it back as "Authorization: Bearer <value>". Leaving this unset makes the
# cron endpoint always refuse — safe default, not a broken one.
CRON_SECRET=

# Not a value you choose: as ADMIN, run in the Supabase SQL editor —
#   SELECT value FROM app_settings WHERE key = 'digest_secret';
# — and paste it here. Generated once by 0018 on first apply.
DIGEST_SECRET=

# Used only to build the "open in app" link inside the digest message.
NEXT_PUBLIC_APP_URL=

# Leave all three empty to skip WhatsApp entirely — /digest still works.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=

# Meta's own WhatsApp Business API (the vars above) cannot post to a WhatsApp
# GROUP at all — only to individuals. To land the digest in a group, point
# this at an n8n webhook (Webhook node's Production URL); the digest route
# POSTs {date, counts, items, groupText} there, and the n8n workflow forwards
# groupText to the group via whatever WhatsApp connection it has (e.g. Green
# API, Whapi.cloud, or a self-hosted Evolution API instance — all unofficial,
# since Meta does not support bots in groups). Leave empty to skip.
N8N_WEBHOOK_URL=
